{
    "name": "hexis/sulu-media-cdn-bundle",
    "description": "Pluggable Sulu media bundle: async variation generation via Messenger + CDN delivery via flysystem-backed FormatCache.",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/hexis-hr/sulu-media-cdn-bundle",
    "support": {
        "issues": "https://github.com/hexis-hr/sulu-media-cdn-bundle/issues",
        "source": "https://github.com/hexis-hr/sulu-media-cdn-bundle"
    },
    "keywords": ["sulu", "media", "cdn", "s3", "flysystem", "messenger", "image-variation"],
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php": "^3.0",
        "league/flysystem": "^3.10",
        "league/flysystem-aws-s3-v3": "^3.10",
        "league/flysystem-bundle": "^3.0",
        "sulu/sulu": "^3.0",
        "symfony/config": "^7.3",
        "symfony/console": "^7.3",
        "symfony/dependency-injection": "^7.3",
        "symfony/event-dispatcher": "^7.3",
        "symfony/http-foundation": "^7.3",
        "symfony/http-kernel": "^7.3",
        "symfony/messenger": "^7.3"
    },
    "require-dev": {
        "league/flysystem-memory": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "symfony/framework-bundle": "^7.3"
    },
    "autoload": {
        "psr-4": { "Hexis\\SuluMediaCdnBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Hexis\\SuluMediaCdnBundle\\Tests\\": "tests/" }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
